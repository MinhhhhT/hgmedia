# Container credentials. Replace every example password before deployment.
DWH_PG_DB=data_warehouse
DWH_PG_USER=dev
DWH_PG_PASSWORD=change-me
WINDOWS_PG_HOST=host.docker.internal
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
# Optional: omit these two variables to reuse DWH_PG_USER/DWH_PG_PASSWORD.
AIRFLOW_DB_USER=postgres
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# Host-side ports. These defaults avoid the native services currently running in WSL.
MINIO_API_EXPOSE_PORT=9000
MINIO_CONSOLE_EXPOSE_PORT=9003
AIRFLOW_EXPOSE_PORT=8081

# External source connections used by the ETL jobs.
ODOO_PG_HOST=
ODOO_PG_PORT=5432
ODOO_PG_DB=
ODOO_PG_USER=
ODOO_PG_PASSWORD=
HGSTOCK_HOST=
HGSTOCK_PORT=5432
HGSTOCK_DB=
HGSTOCK_USER=
HGSTOCK_PASSWORD=
CHANNEL_HOST=
CHANNEL_PORT=1433
CHANNEL_USER=
CHANNEL_PASSWORD=
EDITING_HOST=
EDITING_PORT=1433
EDITING_DB=
EDITING_USER=
EDITING_PASSWORD=
RS_HOST=
RS_PORT=1433
RS_USER=
RS_PASSWORD=
ELASTIC_HOST=
ELASTIC_USER=
ELASTIC_PASSWORD=
