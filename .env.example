# =============================================================================
# HG MEDIA DWH - LIVE / DEPLOYMENT ENVIRONMENT TEMPLATE
# Copy to .env and fill real endpoints/secrets through a secure channel.
# Never commit .env or service-account JSON files.
#
# IMPORTANT:
# - This file is for real source systems.
# - Each source may have a different host, port, database and credential set.
# - LOCAL_FIXTURE_MODE=false means extractors connect to the real sources.
# - .env.rebuild.example is ONLY for disposable local replicas/offline testing.
# =============================================================================

# Runtime
DWH_PROJECT_ROOT=/opt/airflow/project
LOCAL_FIXTURE_MODE=false
LOCAL_FIXTURE_DIR=exports/hgmediadb_samples_1000_20260828_000045

# DWH PostgreSQL (target warehouse, not a source system)
DWH_PG_HOST=
DWH_PG_PORT=5432
DWH_PG_DB=data_warehouse
DWH_PG_USER=
DWH_PG_PASSWORD=

# Airflow metadata PostgreSQL (may be a different server from DWH)
AIRFLOW_DB_HOST=
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# MinIO / object storage
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_RAW_BUCKET=raw-bronze
MINIO_API_EXPOSE_PORT=9000
MINIO_CONSOLE_EXPOSE_PORT=9003
AIRFLOW_EXPOSE_PORT=8081

# -----------------------------------------------------------------------------
# DATABASE SOURCE SYSTEMS
# Every block below is independent. Use the real network endpoint for that
# source; it does NOT need to be inside Docker or on the same host as Airflow.
# -----------------------------------------------------------------------------

# Odoo PostgreSQL
ODOO_PG_HOST=
ODOO_PG_PORT=5432
ODOO_PG_DB=odoo
ODOO_PG_USER=
ODOO_PG_PASSWORD=

# HG Stock PostgreSQL
HGSTOCK_HOST=
HGSTOCK_PORT=5432
HGSTOCK_DB=hgstock
HGSTOCK_USER=
HGSTOCK_PASSWORD=

# Editing SQL Server
EDITING_HOST=
EDITING_PORT=1433
EDITING_DB=editing-management
EDITING_USER=
EDITING_PASSWORD=

# Record Survey SQL Server
RS_HOST=
RS_PORT=1433
RS_DB=record-survey
RS_USER=
RS_PASSWORD=

# Channel Service SQL Server
# Shared values are optional fallbacks only. If services are on different
# servers, leave these blank and fill the per-service values below.
CHANNEL_HOST=
CHANNEL_PORT=
CHANNEL_USER=
CHANNEL_PASSWORD=

CHANNEL_ACCOUNTANT_HOST=
CHANNEL_ACCOUNTANT_PORT=
CHANNEL_ACCOUNTANT_DB=channel.service.accountant
CHANNEL_ACCOUNTANT_USER=
CHANNEL_ACCOUNTANT_PASSWORD=

CHANNEL_CHANNEL_HOST=
CHANNEL_CHANNEL_PORT=
CHANNEL_CHANNEL_DB=channel.service.channel
CHANNEL_CHANNEL_USER=
CHANNEL_CHANNEL_PASSWORD=

CHANNEL_NETWORK_HOST=
CHANNEL_NETWORK_PORT=
CHANNEL_NETWORK_DB=channel.service.network
CHANNEL_NETWORK_USER=
CHANNEL_NETWORK_PASSWORD=

CHANNEL_ORGANIZATION_HOST=
CHANNEL_ORGANIZATION_PORT=
CHANNEL_ORGANIZATION_DB=channel.service.organization
CHANNEL_ORGANIZATION_USER=
CHANNEL_ORGANIZATION_PASSWORD=

CHANNEL_PROJECT_HOST=
CHANNEL_PROJECT_PORT=
CHANNEL_PROJECT_DB=channel.service.project
CHANNEL_PROJECT_USER=
CHANNEL_PROJECT_PASSWORD=

CHANNEL_RELATIONSHIP_HOST=
CHANNEL_RELATIONSHIP_PORT=
CHANNEL_RELATIONSHIP_DB=channel.service.relationship
CHANNEL_RELATIONSHIP_USER=
CHANNEL_RELATIONSHIP_PASSWORD=

# Elasticsearch
ELASTIC_HOST=
ELASTIC_USER=
ELASTIC_PASSWORD=

# Sale API
SALE_API_URL=

# CSV source
STREAM_DISTRO_PATH=data/fact_view_stream.csv
STREAM_DISTRO_FIXTURE_PATH=source_replicas/fixtures/staging.stream_distro.csv

# Google service account + source IDs
GSHEET_CREDENTIALS_PATH=config/gsheet_service_account.json
GSHEET_PARTNERS_PURCHASE_COST_ID=
GDRIVE_PURCHASED_RESOURCE_FOLDER_ID=
GSHEET_RESOURCE_BEFORE_ODOO_ID=
GDRIVE_RESOURCE_PERFORMANCE_FOLDER_ID=
GSHEET_DISTRO_INFORMATION_ID=
GSHEET_RESOURCE_INFORMATION_ADD_ID=
