# =============================================================================
# HG MEDIA DWH - ENVIRONMENT TEMPLATE
# Copy to .env and fill real secrets through a secure channel.
# Never commit .env or service-account JSON files.
# =============================================================================

# Runtime
DWH_PROJECT_ROOT=/opt/airflow/project
LOCAL_FIXTURE_MODE=false
LOCAL_FIXTURE_DIR=exports/hgmediadb_samples_1000_20260828_000045

# DWH PostgreSQL
DWH_PG_HOST=
DWH_PG_PORT=5432
DWH_PG_DB=data_warehouse
DWH_PG_USER=
DWH_PG_PASSWORD=

# Airflow metadata database
WINDOWS_PG_HOST=
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_RAW_BUCKET=raw-bronze
MINIO_API_EXPOSE_PORT=9000
MINIO_CONSOLE_EXPOSE_PORT=9003
AIRFLOW_EXPOSE_PORT=8081

# Odoo PostgreSQL
ODOO_PG_HOST=
ODOO_PG_PORT=5432
ODOO_PG_DB=odoo
ODOO_PG_USER=
ODOO_PG_PASSWORD=

# HG Stock PostgreSQL
