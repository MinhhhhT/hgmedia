# =============================================================================
# LOCAL REBUILD ONLY
# Disposable development credentials and local source replicas.
# Do NOT use this template for real HG source systems.
# For live endpoints, copy .env.example instead.
# =============================================================================
LOCAL_FIXTURE_MODE=true
LOCAL_FIXTURE_DIR=exports/hgmediadb_samples_1000_20260828_000045
DWH_PROJECT_ROOT=/opt/airflow/project

# GitHub Codespaces / nested Docker compatibility for LOCAL platform services.
DOCKER_HOST_GATEWAY=host.docker.internal

# Local DWH / Airflow PostgreSQL service through published host port
AIRFLOW_DB_HOST=host.docker.internal
AIRFLOW_DB_PORT=55432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=hgdev
AIRFLOW_DB_PASSWORD=local-dwh-change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local-airflow-change-me

DWH_PG_HOST=host.docker.internal
DWH_PG_PORT=55432
DWH_PG_DB=data_warehouse
DWH_PG_USER=hgdev
DWH_PG_PASSWORD=local-dwh-change-me
LOCAL_DWH_PG_EXPOSE_PORT=55432

# Local MinIO through published host port
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_INIT_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local-minio-change-me
MINIO_SECURE=false
MINIO_RAW_BUCKET=raw-bronze
MINIO_API_EXPOSE_PORT=9000
MINIO_CONSOLE_EXPOSE_PORT=9003
AIRFLOW_EXPOSE_PORT=8081

# =============================================================================
# FAKE SOURCE NETWORK
# =============================================================================
# Every SQL source is exposed to the EL code through a distinct unroutable
# loopback IP/port.  The application therefore behaves as if it were talking to
# multiple external source systems, while socat forwards traffic only to local
# disposable Docker replicas.  Nothing below can route to a production network.
LOCAL_SOURCE_PROXY_MODE=true
SOURCE_PROXY_PG_BACKEND_HOST=host.docker.internal
SOURCE_PROXY_PG_BACKEND_PORT=5433
SOURCE_PROXY_MSSQL_BACKEND_HOST=host.docker.internal
SOURCE_PROXY_MSSQL_BACKEND_PORT=1434

# Local backend admin credentials used only by the bootstrap process.
SOURCE_PG_ADMIN_USER=hgsource
SOURCE_PG_ADMIN_PASSWORD=local-source-pg-change-me
SOURCE_MSSQL_SA_PASSWORD=Local-Mssql-Change-Me-2026!
LOCAL_SOURCE_PG_EXPOSE_PORT=5433
LOCAL_SOURCE_MSSQL_EXPOSE_PORT=1434

# Odoo PostgreSQL - fake external endpoint
ODOO_PG_HOST=127.20.0.11
ODOO_PG_PORT=5432
ODOO_PG_DB=odoo
ODOO_PG_USER=hgsource
ODOO_PG_PASSWORD=local-source-pg-change-me

# HG Stock PostgreSQL - fake external endpoint
HGSTOCK_HOST=127.20.0.12
HGSTOCK_PORT=5432
HGSTOCK_DB=hgstock
HGSTOCK_USER=hgsource
HGSTOCK_PASSWORD=local-source-pg-change-me

# Editing SQL Server - fake external endpoint
EDITING_HOST=127.20.0.21
EDITING_PORT=1433
EDITING_DB=editing-management
EDITING_USER=sa
EDITING_PASSWORD=Local-Mssql-Change-Me-2026!

# Record Survey SQL Server - fake external endpoint
RS_HOST=127.20.0.22
RS_PORT=1433
RS_DB=record-survey
RS_USER=sa
RS_PASSWORD=Local-Mssql-Change-Me-2026!

# Channel services - each logical service has its own fake IP/port.
CHANNEL_ACCOUNTANT_HOST=127.20.0.30
CHANNEL_ACCOUNTANT_PORT=1433
CHANNEL_ACCOUNTANT_DB=channel.service.accountant
CHANNEL_ACCOUNTANT_USER=sa
CHANNEL_ACCOUNTANT_PASSWORD=Local-Mssql-Change-Me-2026!

CHANNEL_CHANNEL_HOST=127.20.0.31
CHANNEL_CHANNEL_PORT=1433
CHANNEL_CHANNEL_DB=channel.service.channel
CHANNEL_CHANNEL_USER=sa
CHANNEL_CHANNEL_PASSWORD=Local-Mssql-Change-Me-2026!

CHANNEL_NETWORK_HOST=127.20.0.32
CHANNEL_NETWORK_PORT=1433
CHANNEL_NETWORK_DB=channel.service.network
CHANNEL_NETWORK_USER=sa
CHANNEL_NETWORK_PASSWORD=Local-Mssql-Change-Me-2026!

CHANNEL_ORGANIZATION_HOST=127.20.0.33
CHANNEL_ORGANIZATION_PORT=1433
CHANNEL_ORGANIZATION_DB=channel.service.organization
CHANNEL_ORGANIZATION_USER=sa
CHANNEL_ORGANIZATION_PASSWORD=Local-Mssql-Change-Me-2026!

CHANNEL_PROJECT_HOST=127.20.0.34
CHANNEL_PROJECT_PORT=1433
CHANNEL_PROJECT_DB=channel.service.project
CHANNEL_PROJECT_USER=sa
CHANNEL_PROJECT_PASSWORD=Local-Mssql-Change-Me-2026!

CHANNEL_RELATIONSHIP_HOST=127.20.0.35
CHANNEL_RELATIONSHIP_PORT=1433
CHANNEL_RELATIONSHIP_DB=channel.service.relationship
CHANNEL_RELATIONSHIP_USER=sa
CHANNEL_RELATIONSHIP_PASSWORD=Local-Mssql-Change-Me-2026!

# Legacy shared Channel fallback is deliberately left empty in local rebuild so
# a missing per-service fake endpoint fails fast instead of silently collapsing
# multiple logical systems onto one address.
CHANNEL_HOST=
CHANNEL_PORT=
CHANNEL_USER=
CHANNEL_PASSWORD=

# Live non-DB connectors are not needed while LOCAL_FIXTURE_MODE=true.
# These 12 non-SQL sources still replay exported fixtures; they are not yet
# network-mocked HTTP/Google/Elastic services.
ELASTIC_HOST=
ELASTIC_USER=
ELASTIC_PASSWORD=
SALE_API_URL=
STREAM_DISTRO_PATH=data/fact_view_stream.csv
STREAM_DISTRO_FIXTURE_PATH=source_replicas/fixtures/staging.stream_distro.csv
GSHEET_CREDENTIALS_PATH=config/gsheet_service_account.json
GSHEET_PARTNERS_PURCHASE_COST_ID=
GDRIVE_PURCHASED_RESOURCE_FOLDER_ID=
GSHEET_RESOURCE_BEFORE_ODOO_ID=
GDRIVE_RESOURCE_PERFORMANCE_FOLDER_ID=
GSHEET_DISTRO_INFORMATION_ID=
GSHEET_RESOURCE_INFORMATION_ADD_ID=
